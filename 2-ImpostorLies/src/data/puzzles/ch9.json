    "characters": [
      {
        "id": "A",
        "name": "银徽证人",
        "blurb": "语速极快"
      },
      {
        "id": "B",
        "name": "金徽证人",
        "blurb": "滴水不漏"
      },
      {
        "id": "C",
        "name": "铁徽证人",
        "blurb": "频繁眨眼"
      },
      {
        "id": "D",
        "name": "铜徽证人",
        "blurb": "不停擦汗"
      }
    ],
    "statements": [
      {
        "id": "stmt_A",
        "speaker": "A",
        "text": "铁徽证人 不是伪装者。",
        "expr": {
          "op": "not",
          "arg": {
            "op": "roleIs",
            "character": "C",
            "role": "impostor"
          }
        }
      },
      {
        "id": "stmt_B",
        "speaker": "B",
        "text": "我不是领航员。",
        "expr": {
          "op": "not",
          "arg": {
            "op": "roleIs",
            "character": "B",
            "role": "pilot"
          }
        }
      },
      {
        "id": "stmt_C",
        "speaker": "C",
        "text": "银徽证人 和 金徽证人 说的真假不一样。",
        "expr": {
          "op": "xorTruth",
          "left": "stmt_A",
          "right": "stmt_B"
        }
      },
      {
        "id": "stmt_D",
        "speaker": "D",
        "text": "我是工程师。",
        "expr": {
          "op": "roleIs",
          "character": "D",
          "role": "engineer"
        }
      }
    ],
    "mechanic": "身份谜·进阶：四人身份各不相同，且证词会引用彼此的真假（「我和他的话同真/同假」）。"
  },
